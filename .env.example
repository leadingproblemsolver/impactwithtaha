# Never commit a real key. Configure secrets in Vercel Project Settings.
OPENAI_API_KEY=

# Production recommendation for highest-quality tailoring.
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=2200

# Public URL / artifact safety and latency bounds.
ANALYZE_FETCH_TIMEOUT_MS=9000
ANALYZE_MODEL_TIMEOUT_MS=30000
ANALYZE_MAX_SOURCE_BYTES=1000000
ANALYZE_MAX_SOURCE_CHARS=50000
ANALYZE_MAX_ARTIFACT_CHARS=45000

# Optional durable behavioral receipt sink. If unset, events remain in Vercel logs.
IMPACT_EVENT_SINK_URL=
IMPACT_EVENT_SINK_TOKEN=
